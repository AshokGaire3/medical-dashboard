# Backend uses appsettings.json / appsettings.Development.json, but these env
# vars override them via the standard ASP.NET Core configuration provider.

# Connection string — use SQLite for zero-config local dev.
# ConnectionStrings__DefaultConnection=Data Source=meddash.db

# For SQL Server:
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=MedicalDashboard;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;

# JWT settings (leave Jwt__Key empty to auto-generate an ephemeral dev key)
# Jwt__Key=replace-with-32+-char-random-secret
# Jwt__Issuer=meddash
# Jwt__Audience=meddash
# Jwt__ExpiresMinutes=120

# CORS
# Cors__AllowedOrigins__0=http://localhost:5173
