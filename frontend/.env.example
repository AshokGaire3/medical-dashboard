# API base URL (no trailing slash). Must include /api.
VITE_API_URL=http://localhost:5000/api

# Used when building for production (overrides in CI/CD).
# VITE_PROD_API_URL=https://your-api.example.com/api

# Optional base path when hosted under a sub-path (e.g. GitHub Pages).
# VITE_BASE_PATH=/Medical-Dashboard/
